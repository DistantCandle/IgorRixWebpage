@using IgorRixWebpage.Web.Models.NestedElements
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HeaderComponent>

<header class="site-header @(Model.StickyHeader ? "site-header--sticky" : "")" id="site-header">
    <div class="site-header__container">

        <!-- Logo -->
        <a class="site-header__logo" href="/" aria-label="Inclusive Access - Home">
            @if (!string.IsNullOrEmpty(Model.Logo))
            {
                <img src="@Model.Logo" alt="Inclusive Access" class="site-header__logo-image" />
            }
            else
            {
                <span class="site-header__logo-text">Inclusive Access</span>
            }
        </a>

        <!-- Desktop Navigation -->
        <nav class="site-navigation" aria-label="Main navigation">
            <ul class="site-navigation__list">
                @foreach (var item in Model.Navigation)
                {
                    var hasChildren = item.Children != null && item.Children.Any();

                    <li class="site-navigation__item @(hasChildren ? "site-navigation__item--has-children" : "")">
                        <a href="@item.Url" class="site-navigation__link @(item.Active ? "is-active" : "")">
                            @item.Name
                            @if (hasChildren)
                            {
                                <span class="site-navigation__arrow" aria-hidden="true">↓</span>
                            }
                        </a>

                        @if (hasChildren)
                        {
                            <ul class="site-navigation__dropdown">
                                @foreach (var child in item.Children)
                                {
                                    <li>
                                        <a href="@child.Url" class="site-navigation__dropdown-link">@child.Name</a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </nav>

        <!-- CTA -->
        @if (Model.ShowCTA && !string.IsNullOrEmpty(Model.CtaLink))
        {
            <a href="@Model.CtaLink" class="site-header__cta">
                @Model.CtaText <span aria-hidden="true">→</span>
            </a>
        }
    </div>
</header>