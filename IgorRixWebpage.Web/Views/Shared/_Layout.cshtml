@model IgorRixWebpage.Web.Models.ViewModels.BasePageViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Roboto+Slab:wght@700&display=swap" rel="anonymous">
</head>

<body>
    <header>
        <!--navbar start-->
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-logo-container" href="@Url.Content("~/")">
                    <div class="logo-fragment-box">
                        <div class="logo-main-text">
                            <div class="logo-row-1">
                                <span class="Roboto Slab">I</span>nclusive
                            </div>
                            <div class="logo-row-2">
                                Access
                            </div>
                        </div>
                        <div class="logo-subtext-line">no barriers</div>
                    </div>
                </a>
                <ul class="nav-links">
                    <li><a href="@Url.Content("~/")">Home</a></li>
                    <li><a href="@Url.Content("~/AboutUs")">About Us</a></li>
                    <li><a href="@Url.Content("~/Services")">Services</a></li>
                    <li><a href="@Url.Content("~/ContactUs")">Contact Us</a> </li>
                    @* <li>
                            <form action="/searchresults/" method="GET" class="search-form">
                                <input type="text" name="query" placeholder="Search..." class="search-input" />
                                <button type="submit" class="search-button">
                                    Search
                                </button>
                            </form>
                        </li> *@
                </ul>
            </div>
        </nav>
        <!--navbar end-->
    </header>

    <!--Sample Text-->
    <p>Lorem Ipsum dolor set amet....</p>

    <main role='main'>

        @{
            var blocks = Model?.PageContentCompositionModel?.Blocks;
            var blockViewMap = new Dictionary<Type, string>
            {
                // Add new block types here
            };

            if (blocks != null && blocks.Any())
            {
                foreach (var block in blocks)
                {
                    var blockType = block.GetType();

                    if (blockViewMap.TryGetValue(blockType, out var viewPath))
                    {
                        @await Html.PartialAsync(viewPath, block)
                    }
                }
            }

            @RenderBody()
        }
    </main>
    <footer class="footer">
        <ul class="footer-links">
            <li><a href="@Url.Content("~/")">Home</a></li>
            <li><a href="@Url.Content("~/ContactUs")">Contact Us</a></li>
        </ul>
        <p>&copy; @DateTime.Now.Year MyWebsite. All rights reserved.</p>
    </footer>

</body>